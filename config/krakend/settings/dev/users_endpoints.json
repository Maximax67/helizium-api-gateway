{
  "prefix": "u",
  "host": ["http://main-service:3501"],
  "versioning": true,
  "verify_api_tokens": true,
  "claims_propagation": false,
  "endpoints": [
    {
      "path": "me",
      "method": "GET",
      "auth": true,
      "api_tokens": true
    },
    {
      "path": "me/bio",
      "method": "PUT",
      "auth": true
    },
    {
      "path": "me/location",
      "method": "PUT",
      "auth": true
    },
    {
      "path": "me/industry",
      "method": "PUT",
      "auth": true
    },
    {
      "path": "me/eth-address",
      "method": "PUT",
      "auth": true
    },
    {
      "path": "{userId}/public",
      "method": "GET",
      "router_headers": ["Content-Type"],
      "backend_headers": ["Content-Type"]
    }
  ]
}