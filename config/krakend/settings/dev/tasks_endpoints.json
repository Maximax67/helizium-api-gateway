{
  "prefix": "tasks",
  "host": ["http://main-service:3501"],
  "versioning": true,
  "verify_api_tokens": true,
  "claims_propagation": false,
  "endpoints": [
    {
      "path": "",
      "method": "GET",
      "router_headers": ["Content-Type", "Cookie", "Authorization"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "",
      "method": "POST",
      "auth": true,
      "api_tokens": true
    },
    {
      "path": "{taskId}",
      "method": "GET",
      "router_headers": ["Content-Type", "Cookie", "Authorization"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "{taskId}",
      "method": "PUT",
      "auth": true,
      "api_tokens": true
    },
    {
      "path": "{taskId}",
      "method": "DELETE",
      "auth": true,
      "api_tokens": true
    },
    {
      "path": "{taskId}/apply",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/reject/{applicantId}",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/approve/{applicantId}",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/submit-work",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/complete",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/reject-work",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/discard-freelancer",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/raise-dispute",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/resolve-dispute",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/rate",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/comments",
      "method": "GET",
      "router_headers": ["Content-Type", "Cookie", "Authorization"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "{taskId}/comments",
      "method": "POST",
      "auth": true
    },
    {
      "path": "{taskId}/comments/{commentId}",
      "method": "DELETE",
      "auth": true
    },
    {
      "path": "{taskId}/reports",
      "method": "POST",
      "auth": true
    }
  ]
}