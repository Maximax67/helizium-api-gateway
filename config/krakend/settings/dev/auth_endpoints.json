{
  "prefix": "auth",
  "host": ["http://auth-service:3500"],
  "versioning": false,
  "verify_api_tokens": false,
  "claims_propagation": true,
  "endpoints": [
    {
      "path": "jwks",
      "method": "GET",
      "router_headers": ["Content-Type"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "signup",
      "method": "POST",
      "router_headers": [
        "Content-Type",
        "Cookie",
        "Captcha-Id",
        "Captcha-Answer"
      ],
      "backend_headers": [
        "Content-Type",
        "Cookie",
        "Captcha-Id",
        "Captcha-Answer"
      ]
    },
    {
      "path": "sign",
      "method": "POST",
      "router_headers": ["Content-Type", "Captcha-Id", "Captcha-Answer"],
      "backend_headers": ["Content-Type", "Captcha-Id", "Captcha-Answer"]
    },
    {
      "path": "info",
      "method": "GET",
      "auth": true,
      "api_tokens": true
    },
    {
      "path": "logout",
      "method": "POST",
      "auth": true
    },
    {
      "path": "terminate",
      "method": "POST",
      "auth": true
    },
    {
      "path": "lost-password/send-email",
      "method": "POST",
      "router_headers": ["Content-Type", "Captcha-Id", "Captcha-Answer"],
      "backend_headers": ["Content-Type", "Captcha-Id", "Captcha-Answer"]
    },
    {
      "path": "lost-password/verify",
      "method": "POST",
      "router_headers": ["Content-Type"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "lost-password/change",
      "method": "POST",
      "router_headers": ["Content-Type"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "change-password",
      "method": "POST",
      "auth": true
    },
    {
      "path": "mfa",
      "method": "GET",
      "auth": true
    },
    {
      "path": "mfa",
      "method": "POST",
      "auth": true
    },
    {
      "path": "mfa/email/send-code",
      "method": "POST",
      "auth": true
    },
    {
      "path": "mfa/email/confirm",
      "method": "POST",
      "router_headers": ["Content-Type", "Cookie", "Authorization"],
      "backend_headers": ["Content-Type", "Cookie", "Authorization"]
    },
    {
      "path": "mfa/email/cancel",
      "method": "DELETE",
      "auth": true
    },
    {
      "path": "mfa/email/verify",
      "method": "GET",
      "auth": true
    },
    {
      "path": "mfa/totp",
      "method": "DELETE",
      "auth": true
    },
    {
      "path": "mfa/totp/init",
      "method": "POST",
      "auth": true
    },
    {
      "path": "mfa/totp/confirm",
      "method": "POST",
      "auth": true
    },
    {
      "path": "api-tokens/validate",
      "method": "POST",
      "router_headers": ["Content-Type"],
      "backend_headers": ["Content-Type"]
    },
    {
      "path": "api-tokens",
      "method": "GET",
      "auth": true
    },
    {
      "path": "api-tokens",
      "method": "POST",
      "auth": true
    },
    {
      "path": "api-tokens",
      "method": "DELETE",
      "auth": true
    },
    {
      "path": "api-tokens/{jti}",
      "method": "GET",
      "auth": true
    },
    {
      "path": "api-tokens/{jti}",
      "method": "DELETE",
      "auth": true
    }
  ]
}